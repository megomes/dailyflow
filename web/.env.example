# Required
DATABASE_URL=            # Neon Postgres (use a dev branch locally); schema in db/schema.sql
ACCESS_CODE_HASH=        # npm run hash-code -- "<your access code>"
SESSION_SECRET=          # any long random string
APP_URL=http://localhost:3000
CONTACT_EMAIL=           # shown on /privacy and /terms

# Optional: calendars (Google, Microsoft; ICS links need only the key)
CALENDAR_TOKEN_KEY=      # base64, 32 bytes: encrypts calendar tokens at rest
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Optional: push and live updates to the Android app (Firebase)
FIREBASE_SERVICE_ACCOUNT=
LIVE_DB_URL=
LIVE_CHANNEL=            # 48 hex characters
